# Servicio slim del canal bot-a-bot v1 (Render free).
# Solo Hono + postgres: sin app, sin navegador, sin postgres embebido.
# La BD es Supabase; el puerto lo inyecta Render ($PORT).
FROM oven/bun:1.4.3@sha256:ec06c3b6cea007d094d343f668ca417d19fa44721c6b3b72183120ea19bda9f2 AS bun-toolchain

FROM ubuntu:24.04 AS base
COPY --from=bun-toolchain /usr/local/bin/bun /usr/local/bin/bun
RUN useradd --uid 1001 --create-home --shell /usr/sbin/nologin apiuser

FROM base AS runtime
WORKDIR /app
ENV BUN_INSTALL=/usr/local
ENV PATH="/usr/local/bin:${PATH}"
ENV NODE_ENV=production
COPY canal.package.json package.json
COPY canal.bun.lock bun.lock
RUN bun install --frozen-lockfile --production && rm -rf /root/.cache /tmp/*
COPY server/src/canal ./canal
RUN chown -R apiuser:apiuser /app
USER apiuser
EXPOSE 3001
HEALTHCHECK --interval=10s --timeout=5s --start-period=10s --retries=5 \
  CMD bun -e "const r = await fetch('http://127.0.0.1:' + (process.env.PORT || '3001') + '/health'); process.exit(r.ok ? 0 : 1)"
CMD ["bun", "canal/standalone.ts"]
